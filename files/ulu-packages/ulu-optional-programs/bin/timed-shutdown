#!/bin/bash
#
# timed-shutdown -- interactively schedule (or cancel) a system shutdown
#
# This is a thin, GNU-style front end for the standard shutdown(8)
# command, so it behaves the same way no matter which init system is
# running underneath (systemd, SysV init, OpenRC, runit, ...).
#
# Copyright (C) 2026 Your Name <you@example.com>
# License GPLv3+: GNU GPL version 3 or later <https://gnu.org/licenses/gpl.html>
# This is free software: you are free to change and redistribute it.
# There is NO WARRANTY, to the extent permitted by law.

PROGNAME=$(basename "$0")
VERSION="1.0"

usage() {
    cat <<EOF
Usage: $PROGNAME [OPTION]... [TIME]
Interactively schedule a system shutdown, or cancel one already pending.
If TIME is not given on the command line, $PROGNAME will prompt for it.

TIME may be:
  now          shut down immediately
  +m           shut down after m minutes
  hh:mm        shut down at the given time, 24-hour clock

Options:
  -t, --time=TIME       shut down at TIME instead of prompting for it
  -m, --message=MSG     broadcast MSG to logged-in users before shutdown
  -c, --cancel          cancel a previously scheduled shutdown
  -h, --help            display this help text and exit
  -V, --version         output version information and exit

$PROGNAME asks for your password (via sudo) itself before it schedules
or cancels a shutdown, so there's no need to run it with sudo yourself.

Examples:
  $PROGNAME                  ask interactively for a shutdown time
  $PROGNAME -t +30           shut down in 30 minutes
  $PROGNAME --time=23:00     shut down at 23:00
  $PROGNAME --cancel         cancel a pending shutdown

Report bugs to: <you@example.com>
EOF
}

version() {
    cat <<EOF
$PROGNAME $VERSION
License GPLv3+: GNU GPL version 3 or later <https://gnu.org/licenses/gpl.html>
This is free software: you are free to change and redistribute it.
There is NO WARRANTY, to the extent permitted by law.

Written by Your Name.
EOF
}

die() {
    printf '%s: %s\n' "$PROGNAME" "$1" >&2
    printf "Try '%s --help' for more information.\n" "$PROGNAME" >&2
    exit "${2:-1}"
}

# GNU (util-linux) getopt is required for long-option support; the
# original getopt(1), and the one shipped on macOS/BSD, can't do
# --long-options.
getopt --test >/dev/null 2>&1
[[ $? -eq 4 ]] || die "this script requires the GNU (util-linux) 'getopt' utility"

SHORT_OPTS=t:m:cVh
LONG_OPTS=time:,message:,cancel,version,help

if ! PARSED=$(getopt --options="$SHORT_OPTS" --longoptions="$LONG_OPTS" \
                      --name "$PROGNAME" -- "$@"); then
    exit 2
fi
eval set -- "$PARSED"

TIME=
MESSAGE=
CANCEL=0

while true; do
    case "$1" in
        -t|--time)
            TIME=$2
            shift 2
            ;;
        -m|--message)
            MESSAGE=$2
            shift 2
            ;;
        -c|--cancel)
            CANCEL=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -V|--version)
            version
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            die "internal error parsing options"
            ;;
    esac
done

# A bare argument left over is treated as TIME, e.g. `timed-shutdown +15`
if [[ -z "$TIME" && $# -gt 0 ]]; then
    TIME=$1
    shift
fi

[[ $# -eq 0 ]] || die "unexpected argument -- '$1'" 2

if [[ $CANCEL -eq 1 && ( -n "$TIME" || -n "$MESSAGE" ) ]]; then
    die "the '--cancel' option cannot be combined with '--time' or '--message'" 2
fi

if ! SHUTDOWN_BIN=$(command -v shutdown 2>/dev/null); then
    die "could not find the 'shutdown' command on this system"
fi

if [[ $EUID -ne 0 ]] && ! command -v sudo >/dev/null 2>&1; then
    die "root privileges are needed and 'sudo' is not installed; run this as root instead"
fi

as_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

if [[ $CANCEL -eq 1 ]]; then
    as_root "$SHUTDOWN_BIN" -c
    echo "$PROGNAME: pending shutdown cancelled."
    exit 0
fi

TIME_RE='^(now|\+[0-9]+|([01]?[0-9]|2[0-3]):[0-5][0-9])$'

if [[ -z "$TIME" ]]; then
    while true; do
        read -r -p "When would you like to shut the system down? (e.g. now, +15, 23:30): " TIME
        [[ "$TIME" =~ $TIME_RE ]] && break
        printf '%s: "%s" is not a valid time -- try "now", "+15", or "23:30"\n' "$PROGNAME" "$TIME" >&2
    done
elif [[ ! "$TIME" =~ $TIME_RE ]]; then
    die "invalid time format -- '$TIME'" 2
fi

SHUTDOWN_ARGS=(-h "$TIME")
[[ -n "$MESSAGE" ]] && SHUTDOWN_ARGS+=("$MESSAGE")

echo "$PROGNAME: this will run '$SHUTDOWN_BIN -h $TIME' as root; you may be asked for your password."
as_root "$SHUTDOWN_BIN" "${SHUTDOWN_ARGS[@]}"
echo "$PROGNAME: shutdown scheduled for '$TIME'. Run '$PROGNAME --cancel' to abort it."
