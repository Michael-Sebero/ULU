#!/bin/bash

set -uo pipefail

# ---------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------
STATE_DIR="/var/lib/antivirus"
LOG_DIR="/var/log/antivirus"
QUARANTINE_DIR="$STATE_DIR/quarantine"
CACHE_FILE="$STATE_DIR/scanned.cache"
DB_DIR="/var/lib/clamav"
CLAMD_STARTUP_TIMEOUT=60

MODE="quick"
DO_UPDATE=1
DO_DELETE=0
AGGRESSIVE=0
FORCE=0
DO_YES=0
RING_BELL=0
THREADS=""
EXPLICIT_PATHS=()

QUICK_TARGETS=(/home /tmp /bin /var/tmp /var/mail /usr/local /opt /etc)
MAXSIZE_FLAGS=(--max-filesize=100M --max-scansize=100M --pcre-max-filesize=100M)

DEFS_CHANGED=0
HAVE_CLAMD=0
HAVE_FRESHCLAM=0
TOTAL_FOUND=0
SKIPPED_CACHED=0
CANDIDATE_COUNT=0
DETECTED_COUNT=0
QUARANTINED_COUNT=0
DELETED_COUNT=0
ENGINE_USED=""
THREADS_USED=""
CPU_MODEL=""
CPU_THREADS=1
WORKERS=1
IONICE=()
RENICE=()

declare -A CACHE_SEEN
declare -A INFECTED_SET

# Progress display (see "Progress display" below)
IS_TTY=0
[[ -t 1 && "${TERM:-dumb}" != "dumb" ]] && IS_TTY=1
HB_PID=""

print_help() {
    cat <<'EOF'
antivirus - fast, parallel, quarantine-safe ClamAV wrapper

Usage:
  ./antivirus [options] [path ...]

If not already running as root, this re-runs itself through 'su' and
prompts for the root password - no need to type sudo yourself.

If you pass one or more paths, only those are scanned (overrides
--quick/--full).

Options:
  --quick               Scan common hotspots (default): home dirs, tmp,
                        mail spool, /etc, /opt, /usr/local, /bin
  --full                Scan the whole root filesystem (/)
  --threads N           Use N parallel workers (default: auto-detect the
                        CPU and use every thread it has)
  --aggressive          Realtime IO priority + top CPU priority. Faster,
                        but can make the rest of the system sluggish.
  --delete              Permanently delete infected files (default is
                        to quarantine them, so a false positive can't
                        destroy data you can't get back)
  --quarantine-dir DIR  Where to put quarantined files
                        (default: /var/lib/antivirus/quarantine)
  --no-update           Skip the freshclam signature update
  --force               Ignore the unchanged-file cache; rescan everything
  -y, --yes             Don't ask for confirmation; remove infections
                        automatically (needed for cron/unattended runs)
  --bell                Ring the terminal bell if infections are found
  -h, --help            Show this help

By default, if anything infected is found, it's listed on screen and you
get a Y/n prompt before anything is touched. With no terminal to answer
(e.g. cron) and no --yes, infected files are left in place untouched and
logged, rather than either hanging forever or guessing.
EOF
}

log() {
    local msg
    msg="[$(date '+%Y-%m-%d %H:%M:%S')] $*"
    echo "$msg"
    [[ -n "${LOGFILE:-}" ]] && echo "$msg" >> "$LOGFILE"
}

# Like log(), but only to the log file (not the screen).
logfile_only() {
    [[ -n "${LOGFILE:-}" ]] && echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOGFILE"
    return 0
}

# ---------------------------------------------------------------------
# Progress display
#
# Slow steps run next to a small background "heartbeat" that redraws one
# status line every second, so nothing ever looks frozen. On a terminal it
# is an in-place line; with no terminal (cron, a pipe, tee) it falls back to
# a plain log line every 30 seconds. A copy also goes to the log file once a
# minute, so `tail -f` on the log shows progress too.
# ---------------------------------------------------------------------
fmt_secs() {
    local s=$1
    if (( s >= 3600 )); then
        printf '%dh%02dm%02ds' $(( s / 3600 )) $(( s % 3600 / 60 )) $(( s % 60 ))
    elif (( s >= 60 )); then
        printf '%dm%02ds' $(( s / 60 )) $(( s % 60 ))
    else
        printf '%ds' "$s"
    fi
}

# count_done: sets COUNT_DONE to the number of files finished so far, i.e. the
# number of result lines the scanners have written to $WORKDIR/*.scan (one
# line per file). Only the bytes added since the previous call are read, so
# it stays cheap on huge scans. It sets a variable instead of printing so the
# offsets survive between calls.
declare -A CD_OFF CD_N
COUNT_DONE=0
count_done() {
    local f size off n total=0
    for f in "$WORKDIR"/*.scan; do
        [[ -e "$f" ]] || continue
        size=$(stat -c %s "$f" 2>/dev/null) || continue
        off=${CD_OFF[$f]:-0}
        n=${CD_N[$f]:-0}
        if (( size > off )); then
            n=$(( n + $(tail -c +$(( off + 1 )) "$f" | head -c $(( size - off )) | wc -l) ))
            CD_OFF[$f]=$size
            CD_N[$f]=$n
        fi
        total=$(( total + n ))
    done
    COUNT_DONE=$total
}

# hb_line LABEL ELAPSED_SECS [DONE TOTAL]  ->  one status line, no newline
hb_line() {
    local label="$1" elapsed="$2" done_n="${3:-0}" total="${4:-0}"
    if (( total <= 0 )); then
        printf '%s... %s' "$label" "$(fmt_secs "$elapsed")"
        return 0
    fi
    (( done_n > total )) && done_n=$total
    local pm=$(( done_n * 1000 / total )) rate=0 eta="estimating..." bar="" i d t r
    (( elapsed > 0 )) && rate=$(( done_n / elapsed ))
    (( elapsed >= 3 && done_n > 0 )) && eta="~$(fmt_secs $(( (total - done_n) * elapsed / done_n )))"
    for (( i = 0; i < 20; i++ )); do
        if (( i < pm / 50 )); then bar+="#"; else bar+="-"; fi
    done
    printf -v d "%'d" "$done_n"
    printf -v t "%'d" "$total"
    printf -v r "%'d" "$rate"
    printf '%s [%s] %d.%d%%  %s/%s files  ETA %s  (%s files/s, elapsed %s)' \
        "$label" "$bar" $(( pm / 10 )) $(( pm % 10 )) "$d" "$t" "$eta" "$r" "$(fmt_secs "$elapsed")"
}

# hb_start LABEL [TOTAL]
#   With TOTAL: a progress bar driven by count_done.
#   Without:    just the label and the elapsed time.
# Always pair with hb_stop (the EXIT trap in main() also calls it).
hb_start() {
    local label="$1" total="${2:-0}"
    hb_stop
    local parent=$$ cols=80
    if (( IS_TTY )); then
        cols=$(tput cols 2>/dev/null) || cols=80
        [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
        (( cols >= 20 )) || cols=80
    fi
    (
        trap - EXIT
        local t0=$SECONDS n=0 frame=0 last_log=$SECONDS plain line
        local frames=$'|/-\\'
        # The kill -0 check means a heartbeat can never outlive the script,
        # even if the script is killed outright.
        while kill -0 "$parent" 2>/dev/null; do
            sleep 1
            if (( total > 0 )); then
                count_done
                (( COUNT_DONE > n )) && n=$COUNT_DONE
            fi
            plain=$(hb_line "$label" $(( SECONDS - t0 )) "$n" "$total")
            if (( IS_TTY )); then
                line="${frames:frame++ % 4:1} $plain"
                printf '\r\033[K%s' "${line:0:cols-1}"
                if (( SECONDS - last_log >= 60 )); then
                    logfile_only "$plain"
                    last_log=$SECONDS
                fi
            elif (( SECONDS - last_log >= 30 )); then
                log "$plain"
                last_log=$SECONDS
            fi
        done
    ) &
    HB_PID=$!
}

hb_stop() {
    [[ -n "${HB_PID:-}" ]] || return 0
    { kill "$HB_PID" && wait "$HB_PID"; } 2>/dev/null
    HB_PID=""
    (( IS_TTY )) && printf '\r\033[K'
    return 0
}

# The scanners write one "path: RESULT" line per file to $WORKDIR/*.scan.
# Nothing sits in the data path, so progress tracking can't slow a scan down.
# Afterwards, keep only what matters: infected files (FOUND) go to
# $INFECTED_RAW and per-file errors go to the log; the rest is dropped.
collect_scan_results() {
    grep -h ' FOUND$' "$WORKDIR"/*.scan > "$INFECTED_RAW" 2>/dev/null
    grep -h ' ERROR$' "$WORKDIR"/*.scan 2>/dev/null | sed 's/^/  scan error: /' >> "$LOGFILE"
    rm -f "$WORKDIR"/*.scan
}

# report_scan TOTAL START_SECONDS  - one-line result after a scan finishes
# (call it before collect_scan_results, which deletes the result files)
report_scan() {
    local total="$1" t0="$2" done_n elapsed rate_txt="" d t
    count_done
    done_n=$COUNT_DONE
    elapsed=$(( SECONDS - t0 ))
    (( elapsed > 0 )) && rate_txt=" ($(( done_n / elapsed )) files/s)"
    printf -v d "%'d" "$done_n"
    printf -v t "%'d" "$total"
    log "Scan finished: $d of $t file(s) checked in $(fmt_secs "$elapsed")${rate_txt}."
    if (( done_n * 10 < total * 9 )); then
        log "WARNING: the scanner only reported on $d of $t files, so this scan may be incomplete. Check $LOGFILE and $LOG_DIR/clamd.log."
    fi
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        if ! command -v su >/dev/null 2>&1; then
            echo "This needs root privileges and 'su' isn't available. Re-run this script as root." >&2
            exit 1
        fi
        exec su -c "$(printf '%q ' "$0" "$@")"
    fi
}

check_deps() {
    local missing=() c
    for c in clamscan find sort stat sha256sum mktemp split; do
        command -v "$c" >/dev/null 2>&1 || missing+=("$c")
    done
    if (( ${#missing[@]} > 0 )); then
        echo "ERROR: missing required tools: ${missing[*]}" >&2
        echo "  Debian/Ubuntu: sudo apt-get install clamav coreutils findutils" >&2
        echo "  RHEL/Fedora:   sudo dnf install clamav coreutils findutils" >&2
        echo "  Arch:          sudo pacman -S clamav coreutils findutils" >&2
        exit 4
    fi
    HAVE_CLAMD=0
    if command -v clamdscan >/dev/null 2>&1 && command -v clamd >/dev/null 2>&1; then
        HAVE_CLAMD=1
    fi
    HAVE_FRESHCLAM=0
    command -v freshclam >/dev/null 2>&1 && HAVE_FRESHCLAM=1
}

# detect_cpu: finds out what CPU this machine has and how many threads it can
# run at once. Sets CPU_MODEL and CPU_THREADS. "Threads" means logical CPUs
# (hyper-threads / SMT siblings count), which is what the scanner can really
# run in parallel. nproc goes first because it respects CPU affinity and
# cpusets; the OMP_* variables are unset because nproc would otherwise report
# their value instead of the real count.
detect_cpu() {
    local n=""
    n=$(env -u OMP_NUM_THREADS -u OMP_THREAD_LIMIT nproc 2>/dev/null)
    [[ "$n" =~ ^[1-9][0-9]*$ ]] || n=$(getconf _NPROCESSORS_ONLN 2>/dev/null)
    [[ "$n" =~ ^[1-9][0-9]*$ ]] || n=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
    [[ "$n" =~ ^[1-9][0-9]*$ ]] || n=1
    CPU_THREADS=$n

    CPU_MODEL=""
    if command -v lscpu >/dev/null 2>&1; then
        CPU_MODEL=$(lscpu 2>/dev/null | awk -F: '/^Model name:/ {sub(/^[ \t]+/, "", $2); print $2; exit}')
    fi
    if [[ -z "$CPU_MODEL" && -r /proc/cpuinfo ]]; then
        CPU_MODEL=$(awk -F: '/^(model name|Hardware|Processor)[ \t]*:/ {sub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo)
    fi
    [[ -n "$CPU_MODEL" ]] || CPU_MODEL="unknown CPU"
}

# calc_threads: an explicit --threads N wins; otherwise use every CPU thread.
calc_threads() {
    if [[ -n "$THREADS" ]]; then
        echo "$THREADS"
    else
        echo "$CPU_THREADS"
    fi
}

db_fingerprint() {
    find "$DB_DIR" -maxdepth 1 -type f \( -name '*.cvd' -o -name '*.cld' \) 2>/dev/null \
        | sort | xargs -r stat -c '%n %Y %s' 2>/dev/null | sha256sum | awk '{print $1}'
}

has_database() {
    find "$DB_DIR" -maxdepth 1 -type f \( -name '*.cvd' -o -name '*.cld' \) 2>/dev/null | grep -q .
}

ensure_database() {
    local before after
    before="$(db_fingerprint)"

    if (( DO_UPDATE )); then
        if (( HAVE_FRESHCLAM )); then
            log "Updating virus definitions..."
            local fc_rc=0
            hb_start "Updating virus definitions"
            freshclam --quiet >>"$LOGFILE" 2>&1 || fc_rc=$?
            hb_stop
            if (( fc_rc == 0 )); then
                log "Definition check complete."
            else
                log "WARNING: freshclam could not update (offline, rate-limited, or no permission). Using the existing database."
            fi
        else
            log "freshclam not installed; skipping definition update."
        fi
    fi

    if ! has_database; then
        echo "ERROR: no ClamAV signature database found in $DB_DIR." >&2
        echo "Run 'sudo freshclam' once with internet access, then try again." >&2
        exit 3
    fi

    after="$(db_fingerprint)"
    if [[ "$before" != "$after" ]]; then
        DEFS_CHANGED=1
        log "Signature database changed since last run; ignoring the unchanged-file cache for this run."
    fi
}

clamd_ready() {
    clamdscan --ping 1 >/dev/null 2>&1
}

start_clamd_via_init_system() {
    local svc
    for svc in clamav-daemon clamd@scan clamd; do
        if command -v systemctl >/dev/null 2>&1 && systemctl start "$svc" >/dev/null 2>&1; then
            return 0
        fi
        if command -v service >/dev/null 2>&1 && service "$svc" start >/dev/null 2>&1; then
            return 0
        fi
        if command -v rc-service >/dev/null 2>&1 && rc-service "$svc" start >/dev/null 2>&1; then
            return 0
        fi
        if [[ -x "/etc/init.d/$svc" ]] && "/etc/init.d/$svc" start >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

find_clamd_conf() {
    local c
    for c in /etc/clamav/clamd.conf /etc/clamd.d/scan.conf /etc/clamd.conf; do
        [[ -f "$c" ]] && { echo "$c"; return 0; }
    done
    return 1
}

# clamd_conf_threads CONF: the MaxThreads value in CONF, or ClamAV's built-in
# default (10) when it isn't set. MaxThreads is how many scans clamd will run
# at the same time, so it is the real ceiling in daemon mode.
clamd_conf_threads() {
    local n=""
    [[ -n "${1:-}" ]] && n=$(awk '$1 == "MaxThreads" {v = $2} END {print v}' "$1" 2>/dev/null)
    if [[ "$n" =~ ^[1-9][0-9]*$ ]]; then echo "$n"; else echo 10; fi
}

warn_if_clamd_limited() {
    local cfg
    cfg=$(clamd_conf_threads "$(find_clamd_conf)")
    if (( cfg < WORKERS )); then
        log "NOTE: clamd is configured with MaxThreads=$cfg, below this machine's $WORKERS threads, so the scan may not use every CPU thread. Set 'MaxThreads $WORKERS' in clamd.conf and restart clamd to lift the limit."
    fi
}

start_clamd_directly() {
    local conf
    conf=$(find_clamd_conf) || return 1
    command -v clamd >/dev/null 2>&1 || return 1

    # If the system config would cap clamd below the number of workers, launch
    # it from a copy of that config with MaxThreads raised to match. The
    # system's own clamd.conf is never modified.
    if (( $(clamd_conf_threads "$conf") < WORKERS )); then
        local tuned="$STATE_DIR/clamd-tuned.conf"
        { grep -v -E '^[[:space:]]*MaxThreads([[:space:]]|$)' "$conf"; echo "MaxThreads $WORKERS"; } > "$tuned"
        conf="$tuned"
        log "Launching clamd directly with MaxThreads=$WORKERS (the system config allows fewer)."
    else
        log "No init system actually started clamd; launching it directly."
    fi
    mkdir -p "$LOG_DIR"
    nohup "${IONICE[@]}" "${RENICE[@]}" clamd --config-file="$conf" >>"$LOG_DIR/clamd.log" 2>&1 &
    disown 2>/dev/null || true
    return 0
}

ensure_clamd() {
    command -v clamdscan >/dev/null 2>&1 || return 1
    if clamd_ready; then
        warn_if_clamd_limited
        return 0
    fi

    # NOTE: init scripts can exit 0 without actually starting clamd (e.g.
    # a distro's init.d script silently refusing because it thinks the
    # signature database is missing). Never trust that exit code alone -
    # give it a short window to come up for real, and if it doesn't,
    # fall through to launching clamd ourselves regardless of what the
    # init system claimed.
    log "clamd isn't running yet; starting it..."
    local started_direct=0 conf
    conf=$(find_clamd_conf) || conf=""
    # The stock config would cap the scan below the CPU thread count: skip the
    # init system and start clamd ourselves with the limit raised.
    if [[ -n "$conf" ]] && (( $(clamd_conf_threads "$conf") < WORKERS )); then
        start_clamd_directly && started_direct=1
    fi
    (( started_direct )) || start_clamd_via_init_system

    local waited=0 ready=0
    if (( ! started_direct )); then
        hb_start "Waiting for the init system to bring clamd up"
        while (( waited < 10 )); do
            clamd_ready && { ready=1; break; }
            sleep 1
            ((waited++))
        done
        hb_stop
        if (( ready )); then
            log "clamd is ready."
            warn_if_clamd_limited
            return 0
        fi
        start_clamd_directly
    fi

    waited=0
    log "Waiting for clamd to load the virus signatures (up to ${CLAMD_STARTUP_TIMEOUT}s)..."
    hb_start "Loading virus signatures into clamd"
    while (( waited < CLAMD_STARTUP_TIMEOUT )); do
        clamd_ready && { ready=1; break; }
        sleep 1
        ((waited++))
    done
    hb_stop
    if (( ready )); then
        log "clamd is ready (took ${waited}s)."
        return 0
    fi
    log "WARNING: clamd did not answer within ${CLAMD_STARTUP_TIMEOUT}s (see $LOG_DIR/clamd.log)."
    return 1
}

build_targets() {
    if (( ${#EXPLICIT_PATHS[@]} > 0 )); then
        TARGETS=("${EXPLICIT_PATHS[@]}")
    elif [[ "$MODE" == "full" ]]; then
        TARGETS=(/)
    else
        TARGETS=()
        local t
        for t in "${QUICK_TARGETS[@]}"; do
            [[ -e "$t" ]] && TARGETS+=("$t")
        done
    fi
}

load_cache() {
    [[ -f "$CACHE_FILE" ]] || return 0
    log "Loading the cache of previously scanned files..."
    hb_start "Loading the scan cache"
    local p m s
    while IFS=$'\t' read -r p m s; do
        [[ -z "$p" ]] && continue
        CACHE_SEEN["$p"]="$m $s"
    done < "$CACHE_FILE"
    hb_stop
}

build_candidates() {
    local workdir="$1"
    local all="$workdir/all.txt"
    local kept="$workdir/candidates.txt"

    : > "$all"
    local t
    log "Listing files under: ${TARGETS[*]}"
    hb_start "Listing files"
    for t in "${TARGETS[@]}"; do
        [[ -e "$t" ]] || continue
        # -xdev: stay on each target's own filesystem (skip /proc, /sys,
        # network mounts, USB drives, etc. unless explicitly passed as a
        # target themselves).
        find "$t" -xdev -type f -not -path "${QUARANTINE_DIR}/*" 2>>"$LOGFILE" >> "$all"
    done
    hb_stop

    TOTAL_FOUND=$(wc -l < "$all" | tr -d ' ')
    SKIPPED_CACHED=0

    if (( FORCE )) || (( DEFS_CHANGED )) || [[ ! -s "$CACHE_FILE" ]]; then
        cp "$all" "$kept"
    else
        log "Comparing $TOTAL_FOUND file(s) with the cache of previously scanned files..."
        hb_start "Checking which files changed"
        local f cur
        # stat is run in big batches by xargs. Forking one stat per file was
        # ~1.7ms each: over ten minutes of silence on a few hundred thousand
        # files. (A file that vanished since find ran is simply left out.)
        while IFS=$'\t' read -r cur f; do
            if [[ "${CACHE_SEEN[$f]:-}" == "$cur" ]]; then
                ((SKIPPED_CACHED++))
            else
                printf '%s\n' "$f"
            fi
        done < <(xargs -d '\n' -a "$all" -r stat -c $'%Y %s\t%n' -- 2>/dev/null) > "$kept"
        hb_stop
    fi

    CANDIDATE_COUNT=$(wc -l < "$kept" | tr -d ' ')
    log "Found $TOTAL_FOUND file(s); $SKIPPED_CACHED unchanged since last clean scan; $CANDIDATE_COUNT to scan now."
}

save_cache() {
    local workdir="$1"
    local all="$workdir/all.txt" kept="$workdir/candidates.txt"
    local tmp="$STATE_DIR/scanned.cache.tmp.$$"

    log "Saving the scan cache..."
    hb_start "Saving the scan cache"
    : > "$tmp"

    if [[ -f "$all" && -f "$kept" ]]; then
        comm -23 <(sort -u "$all") <(sort -u "$kept") 2>/dev/null | while IFS= read -r f; do
            v="${CACHE_SEEN[$f]:-}"
            [[ -n "$v" ]] && printf '%s\t%s\n' "$f" "${v/ /$'\t'}"
        done >> "$tmp"
    fi

    if [[ -f "$kept" ]]; then
        local f st
        # Batched stat again (see build_candidates). Files that no longer
        # exist, e.g. quarantined ones, produce no line and are skipped.
        while IFS=$'\t' read -r st f; do
            [[ -n "${INFECTED_SET[$f]:-}" ]] && continue
            printf '%s\t%s\n' "$f" "${st/ /$'\t'}"
        done < <(xargs -d '\n' -a "$kept" -r stat -c $'%Y %s\t%n' -- 2>/dev/null) >> "$tmp"
    fi

    sort -o "$tmp" "$tmp" 2>/dev/null
    mkdir -p "$STATE_DIR"
    mv "$tmp" "$CACHE_FILE"
    hb_stop
}

# run_parallel_scan CANDIDATES COMMAND [ARGS...]
#   Splits the candidate list into WORKERS chunks and runs one copy of
#   COMMAND per chunk, all at once. Each copy writes one "path: RESULT" line
#   per file to $WORKDIR/chunk.*.scan. The list is dealt out round-robin
#   (split -n r/N) rather than in contiguous blocks, so big files that sit
#   together on disk are spread across workers and no worker is left running
#   long after the others have finished.
run_parallel_scan() {
    local candidates="$1"; shift
    local total workers chunk pid pids=() t0

    total=$(wc -l < "$candidates" | tr -d ' ')
    if (( total == 0 )); then
        : > "$INFECTED_RAW"
        return 0
    fi

    workers=$WORKERS
    (( workers > total )) && workers=$total
    THREADS_USED="$workers"

    split -n "r/$workers" "$candidates" "$WORKDIR/chunk."

    log "Scanning $total file(s) with $workers parallel worker(s)..."
    t0=$SECONDS
    hb_start "Scanning" "$total"

    for chunk in "$WORKDIR"/chunk.*; do
        [[ -s "$chunk" ]] || continue
        # No -i: every file gets a result line, which the progress display
        # counts. collect_scan_results keeps only the infected ones afterwards.
        "$@" --file-list="$chunk" > "$chunk.scan" 2>>"$LOGFILE" &
        pids+=($!)
    done

    for pid in "${pids[@]}"; do
        wait "$pid" 2>/dev/null
    done
    hb_stop
    report_scan "$total" "$t0"
    collect_scan_results
}

parse_infected() {
    local raw="$1" out="$2"
    : > "$out"
    [[ -s "$raw" ]] || return 0
    local line rest path sig
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        rest="${line% FOUND}"
        path="${rest%: *}"
        sig="${rest##*: }"
        [[ -e "$path" ]] || continue
        INFECTED_SET["$path"]=1
        printf '%s\t%s\n' "$path" "$sig" >> "$out"
    done < "$raw"
}

report_and_confirm() {
    local parsed="$1" count path sig reply
    count=$(wc -l < "$parsed" | tr -d ' ')
    (( count == 0 )) && return 1

    {
        echo
        echo "$count infected file(s) detected:"
        while IFS=$'\t' read -r path sig; do
            printf '  - %s  [%s]\n' "$path" "$sig"
        done < "$parsed"
        echo
    } | tee -a "$LOGFILE"

    if (( DO_YES )); then
        log "Auto-confirmed removal (--yes)."
        return 0
    fi

    if read -r -t 30 -p "Remove ${count} infected file(s) now? [Y/n] " reply; then
        case "$reply" in
            ""|[Yy]*) return 0 ;;
            *) log "Declined; leaving $count infected file(s) in place."; return 1 ;;
        esac
    else
        echo
        log "No confirmation received; leaving $count infected file(s) in place. Re-run with --yes to remove automatically (e.g. from cron)."
        return 1
    fi
}

remediate() {
    local parsed="$1"
    QUARANTINED_COUNT=0
    DELETED_COUNT=0
    [[ -s "$parsed" ]] || return 0

    (( DO_DELETE )) || mkdir -p "$QUARANTINE_DIR"

    local path sig hash ts destname
    while IFS=$'\t' read -r path sig; do
        [[ -e "$path" ]] || continue

        hash=$(sha256sum -- "$path" 2>/dev/null | awk '{print $1}')
        ts=$(date '+%Y-%m-%d %H:%M:%S')

        if (( DO_DELETE )); then
            rm -f -- "$path"
            printf '%s\tDELETED\t%s\t%s\t%s\t-\n' "$ts" "$path" "$sig" "$hash" >> "$MANIFEST"
            ((DELETED_COUNT++))
            log "DELETED (infected: $sig): $path"
        else
            destname="$QUARANTINE_DIR/$(date +%Y%m%d%H%M%S)__${hash:0:12}__$(basename -- "$path")"
            if mv -- "$path" "$destname" 2>>"$LOGFILE"; then
                chmod 000 -- "$destname" 2>/dev/null
                printf '%s\tQUARANTINED\t%s\t%s\t%s\t%s\n' "$ts" "$path" "$sig" "$hash" "$destname" >> "$MANIFEST"
                ((QUARANTINED_COUNT++))
                log "QUARANTINED (infected: $sig): $path -> $destname"
            else
                log "WARNING: could not quarantine $path"
            fi
        fi
    done < "$parsed"
}

print_summary() {
    local elapsed mins secs rate
    elapsed=$(( $(date +%s) - START_TS ))
    mins=$(( elapsed / 60 ))
    secs=$(( elapsed % 60 ))
    rate="n/a"
    if (( elapsed > 0 && CANDIDATE_COUNT > 0 )); then
        rate="$(( CANDIDATE_COUNT / elapsed )) files/sec"
    fi

    {
        echo
        echo "===================== Scan summary ====================="
        echo "CPU:                 $CPU_MODEL ($CPU_THREADS threads)"
        echo "Engine:              $ENGINE_USED ($THREADS_USED worker(s))"
        echo "Targets:             ${TARGETS[*]}"
        echo "Files found:         $TOTAL_FOUND"
        echo "Skipped (unchanged): $SKIPPED_CACHED"
        echo "Actually scanned:    $CANDIDATE_COUNT"
        echo "Detected infected:   $DETECTED_COUNT"
        echo "Quarantined:         $QUARANTINED_COUNT  -> $QUARANTINE_DIR"
        echo "Deleted:             $DELETED_COUNT"
        if (( DETECTED_COUNT > QUARANTINED_COUNT + DELETED_COUNT )); then
            echo "Left in place:       $(( DETECTED_COUNT - QUARANTINED_COUNT - DELETED_COUNT ))  (removal not confirmed)"
        fi
        echo "Time:                ${mins}m ${secs}s  ($rate)"
        echo "Log:                 $LOGFILE"
        if (( QUARANTINED_COUNT + DELETED_COUNT > 0 )); then
            echo "Manifest:            $MANIFEST"
        fi
        echo "=========================================================="
    } | tee -a "$LOGFILE"

    if (( RING_BELL )) && (( DETECTED_COUNT > 0 )); then
        printf '\a'
    fi
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --quick) MODE="quick"; shift ;;
            --full) MODE="full"; shift ;;
            --threads) THREADS="${2:?--threads needs a number}"; shift 2 ;;
            --aggressive) AGGRESSIVE=1; shift ;;
            --delete) DO_DELETE=1; shift ;;
            --quarantine-dir) QUARANTINE_DIR="${2:?--quarantine-dir needs a path}"; shift 2 ;;
            --no-update) DO_UPDATE=0; shift ;;
            --force) FORCE=1; shift ;;
            -y|--yes) DO_YES=1; shift ;;
            --bell) RING_BELL=1; shift ;;
            -h|--help) print_help; exit 0 ;;
            --) shift; EXPLICIT_PATHS+=("$@"); break ;;
            -*) echo "Unknown option: $1 (see --help)" >&2; exit 2 ;;
            *) EXPLICIT_PATHS+=("$1"); shift ;;
        esac
    done
    if [[ -n "$THREADS" && ! "$THREADS" =~ ^[1-9][0-9]*$ ]]; then
        echo "--threads needs a positive whole number (got '$THREADS')" >&2
        exit 2
    fi
}

main() {
    require_root "$@"
    parse_args "$@"

    # However we exit (Ctrl-C included): stop the progress heartbeat and
    # remove the temp dir.
    trap 'hb_stop; [[ -n "${WORKDIR:-}" ]] && rm -rf "$WORKDIR"' EXIT

    mkdir -p "$STATE_DIR" "$LOG_DIR"
    LOGFILE="$LOG_DIR/scan-$(date +%Y%m%d-%H%M%S).log"
    MANIFEST="$STATE_DIR/quarantine-manifest.tsv"
    START_TS=$(date +%s)

    log "antivirus starting (mode=$MODE, delete=$DO_DELETE, aggressive=$AGGRESSIVE)"

    detect_cpu
    WORKERS=$(calc_threads)
    THREADS_USED="$WORKERS"
    if [[ -n "$THREADS" ]]; then
        log "CPU: $CPU_MODEL, $CPU_THREADS thread(s); --threads given, using $WORKERS worker(s)."
    else
        log "CPU: $CPU_MODEL, $CPU_THREADS thread(s); using all $WORKERS for scanning."
    fi

    check_deps
    load_cache
    ensure_database
    build_targets

    if (( AGGRESSIVE )); then
        IONICE=(ionice -c1 -n0); RENICE=(nice -n -20)
    else
        IONICE=(ionice -c2 -n0); RENICE=(nice -n -5)
    fi
    command -v ionice >/dev/null 2>&1 || IONICE=()
    command -v nice   >/dev/null 2>&1 || RENICE=()

    WORKDIR=$(mktemp -d)

    build_candidates "$WORKDIR"

    INFECTED_RAW="$WORKDIR/infected.raw"
    : > "$INFECTED_RAW"

    if (( HAVE_CLAMD )) && ensure_clamd; then
        ENGINE_USED="clamd daemon (fdpass)"
        log "Using the clamd daemon for scanning."
        run_parallel_scan "$WORKDIR/candidates.txt" \
            clamdscan --fdpass --multiscan --no-summary
    else
        ENGINE_USED="clamscan (parallel fallback)"
        log "clamd unavailable; falling back to parallel clamscan workers."
        run_parallel_scan "$WORKDIR/candidates.txt" \
            "${IONICE[@]}" "${RENICE[@]}" clamscan --no-summary "${MAXSIZE_FLAGS[@]}"
    fi

    local infected_parsed="$WORKDIR/infected_parsed.tsv"
    parse_infected "$INFECTED_RAW" "$infected_parsed"
    DETECTED_COUNT=$(wc -l < "$infected_parsed" | tr -d ' ')
    if report_and_confirm "$infected_parsed"; then
        remediate "$infected_parsed"
    fi
    save_cache "$WORKDIR"
    print_summary
}

main "$@"
